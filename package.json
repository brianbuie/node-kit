{
  "name": "@brianbuie/kit",
  "version": "2.0.6",
  "license": "Unlicense",
  "description": "Basic tools for quick projects",
  "author": "Brian Buie <brian@buie.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brianbuie/kit.git"
  },
  "scripts": {
    "build": "prettier . -w && tsdown",
    "test": "tsc && node --test \"src/**/*.test.ts\" --quiet",
    "preversion": "pnpm test && pnpm run build",
    "postversion": "git push --follow-tags"
  },
  "packageManager": "pnpm@11.22.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/node.d.mts",
      "node": "./dist/node.mjs",
      "default": "./dist/neutral.mjs"
    },
    "./neutral": {
      "types": "./dist/neutral.d.mts",
      "default": "./dist/neutral.mjs"
    },
    "./type-writer": {
      "types": "./dist/type-writer.d.mts",
      "default": "./dist/type-writer.mjs"
    }
  },
  "files": [
    "src",
    "dist",
    "tsconfig.json",
    "prettier.config.js"
  ],
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@types/lodash-es": "^4.17.12",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^24.9.1",
    "@types/probe-image-size": "^7.2.5",
    "chalk": "^6.0.0",
    "date-fns": "^4.1.0",
    "extract-domain": "^5.0.2",
    "fast-csv": "^5.0.5",
    "format-duration": "^3.0.2",
    "lodash-es": "^4.17.23",
    "mime-types": "^3.0.2",
    "probe-image-size": "^7.3.0",
    "sanitize-filename": "^1.6.3",
    "string-argv": "^0.3.2"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "quicktype-core": "^23.2.6",
    "tsdown": "^0.16.6",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "quicktype-core": "^23.2.6"
  },
  "peerDependenciesMeta": {
    "quicktype-core": {
      "optional": true
    }
  }
}
